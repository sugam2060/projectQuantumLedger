DATABASE_URL=postgresql://username:password@localhost:5432/database_name
DATABASE_MIGRATION_URL=postgresql://migration_user:password@localhost:5432/database_name
# Used once to create the fortis_app login on a fresh database. Keep it secret.
FORTIS_APP_DB_PASSWORD=
# Access tokens (HS256). JWT_SECRET is still accepted as the old name.
JWT_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_characters_long
JWT_ACCESS_TTL=15m
JWT_ISSUER=fortis-api
# Business-user and platform-user tokens use different audiences (must differ)
JWT_AUDIENCE=fortis-pos
JWT_PLATFORM_AUDIENCE=fortis-platform
# Refresh sessions: "remember me" lifetime in days, otherwise hours
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_SESSION_TTL_HOURS=12
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
REDIS_URL= redis_url_string

# BullMQ uses REDIS_URL. "false" makes this instance enqueue-only (no workers).
JOBS_WORKERS_ENABLED=true

# Cloudinary object storage for platform business application documents
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_BUSINESS_REQUEST_FOLDER=business-request-documents

# Rate limiting (per client IP and route, fixed window)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
# Limit for @StrictThrottle() credential routes (login, refresh, owner registration)
AUTH_THROTTLE_LIMIT=10

NODE_ENV=development
PORT=3000
# Express trust proxy: false | true | number of proxy hops in front of the app
TRUST_PROXY=false
# Extra browser origins allowed by CORS, comma separated (FRONTEND_BASE_URL is always allowed)
CORS_ALLOWED_ORIGINS=
FRONTEND_BASE_URL=http://localhost:3000

# SMTP for the email queue worker. Defaults (localhost:1025, no auth) suit a local
# catcher such as Mailpit.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME=Fortis
MAIL_FROM_EMAIL=no-reply@fortis.local
MAIL_REPLY_TO=
