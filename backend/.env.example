DATABASE_URL=postgresql://username:password@localhost:5432/database_name
DATABASE_MIGRATION_URL=postgresql://migration_user:password@localhost:5432/database_name
# Used once to create the fortis_app login on a fresh database. Keep it secret.
FORTIS_APP_DB_PASSWORD=
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
REDIS_URL= redis_url_string

# RabbitMQ: set RABBITMQ_URL or use the host-based settings below.
RABBITMQ_URL=
RABBITMQ_HOST=
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
RABBITMQ_HEARTBEAT=30
RABBITMQ_PREFETCH_COUNT=10
RABBITMQ_CONNECTION_TIMEOUT=10000

# Cloudinary object storage for platform business application documents
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_BUSINESS_REQUEST_FOLDER=business-request-documents

# Rate limiting security enhancements
RATE_LIMIT_WHITELIST_IPS=127.0.0.1,::1
RATE_LIMIT_WHITELIST_USER_IDS=
RATE_LIMIT_LOAD_THRESHOLD=0.8

PORT=3000

# SMTP settings used by the standalone mail worker
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME=
MAIL_FROM_EMAIL=
MAIL_REPLY_TO=

# RabbitMQ mail topology and worker controls
MAIL_QUEUE_NAME=mail.queue
MAIL_EXCHANGE_NAME=mail.exchange
MAIL_ROUTING_KEY=mail.send
MAIL_WORKER_CONCURRENCY=5
MAIL_PREFETCH_COUNT=5

# Retry policy (retry queues apply exponential TTL backoff)
MAIL_MAX_RETRIES=5
MAIL_RETRY_INITIAL_DELAY=5000
MAIL_RETRY_MAX_DELAY=300000

# Dead-letter monitoring and idempotency
MAIL_DLQ_ENABLED=true
MAIL_DLQ_EXCHANGE=mail.dlx
MAIL_DLQ_QUEUE=mail.dead-letter.queue
MAIL_DLQ_ROUTING_KEY=mail.dead-letter
MAIL_DLQ_CHECK_INTERVAL=60000
MAIL_IDEMPOTENCY_TTL_SECONDS=86400
MAIL_IDEMPOTENCY_LOCK_TTL_SECONDS=600
MAIL_MAX_ATTACHMENT_SIZE_BYTES=10485760
