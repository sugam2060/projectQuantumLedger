# Copy to .env and fill in. Never commit real values.
# The connection examples match the local Docker stack (docker-compose.yml):
#   npm run dev:up && npm run db:migrate && npm run start:dev

# --- Local Docker services (read by docker-compose.yml) ---------------------

# Passwords for the containers. Pick any long random strings.
POSTGRES_SUPERUSER_PASSWORD=
LOCAL_DB_MIGRATION_PASSWORD=
LOCAL_REDIS_PASSWORD=
# Optional: database name and owner, and host ports (defaults shown).
# LOCAL_DB_NAME=fortis
# LOCAL_DB_MIGRATION_USER=fortis_owner
# LOCAL_DB_PORT=5432
# LOCAL_REDIS_PORT=6379
# LOCAL_SMTP_PORT=1025
# LOCAL_MAIL_UI_PORT=8025

# --- Required -------------------------------------------------------------

# Runtime connection: the API logs in as the least-privileged fortis_app role.
DATABASE_URL=postgresql://fortis_app:<FORTIS_APP_DB_PASSWORD>@localhost:5432/fortis
# Migration connection: the database owner (CREATEROLE, not SUPERUSER).
# Locally: fortis_owner with LOCAL_DB_MIGRATION_PASSWORD. On Neon: the neondb_owner URL.
DATABASE_MIGRATION_URL=postgresql://fortis_owner:<LOCAL_DB_MIGRATION_PASSWORD>@localhost:5432/fortis
# Password `npm run db:migrate` gives the fortis_app role (must match DATABASE_URL).
FORTIS_APP_DB_PASSWORD=

# Signs access tokens. At least 32 random characters.
JWT_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_characters_long

# Rate limits and the email job queue.
REDIS_URL=redis://:<LOCAL_REDIS_PASSWORD>@localhost:6379

PORT=3000
# Website origin: used in emailed links (invitations, password reset) and allowed by CORS.
FRONTEND_BASE_URL=http://localhost:5173

# Document storage for business requests.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (SMTP). These match Mailpit from docker-compose.yml (inbox at
# http://localhost:8025). For a real provider set host, port, secure and login.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=no-reply@fortis.local

NODE_ENV=development

# --- Optional (values shown are the defaults) ------------------------------

# Number of proxies in front of the API (false, true or a hop count).
# TRUST_PROXY=false
# Extra browser origins for CORS, comma separated.
# CORS_ALLOWED_ORIGINS=

# Token and session lifetimes.
# JWT_ACCESS_TTL=15m
# REFRESH_TOKEN_TTL_DAYS=30
# REFRESH_TOKEN_SESSION_TTL_HOURS=12
# PASSWORD_RESET_TTL_MINUTES=30
# JWT_ISSUER=fortis-api
# JWT_AUDIENCE=fortis-pos
# JWT_PLATFORM_AUDIENCE=fortis-platform

# Requests per client per window; the stricter limit applies to sign-in,
# password and invitation routes.
# THROTTLE_TTL_MS=60000
# THROTTLE_LIMIT=100
# AUTH_THROTTLE_LIMIT=10

# Database connection pool.
# DB_POOL_MAX=10
# DB_POOL_MIN=0
# DB_POOL_IDLE_TIMEOUT_MS=30000
# DB_POOL_CONNECTION_TIMEOUT_MS=5000

# "false" makes this instance only enqueue emails (another instance sends them).
# JOBS_WORKERS_ENABLED=true
# MAIL_FROM_NAME=Fortis
# MAIL_REPLY_TO=
# CLOUDINARY_BUSINESS_REQUEST_FOLDER=business-request-documents

# Only if you created the fortis_app role yourself (e.g. in the Neon console) and
# the migration account may not change its password.
# FORTIS_APP_ROLE_EXTERNALLY_MANAGED=false
