    {
      "id": "67224a74-cc1a-55c7-a779-739de6a38e74",
      "name": "05 Staff management",
      "description": "Only platform admins (bootstrap or role admin) can invite staff; the database enforces it too.",
      "item": [
        {
          "id": "f4b32c1a-4a4b-598f-9bd2-43099df4d7d0",
          "name": "Invite staff member",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-client-type",
                "value": "{{clientType}}",
                "description": "web, desktop or mobile. Native clients get the refresh token in the body; web gets it as an httpOnly cookie."
              },
              {
                "key": "x-idempotency-key",
                "value": "{{$guid}}",
                "description": "Required (note the x- prefix on this route)."
              }
            ],
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "platform",
                "users",
                "invite"
              ],
              "raw": "{{baseUrl}}/platform/users/invite"
            },
            "description": "**Permission:** `platform:user:invite`. `role` is admin, manager or support (default support). Emails a single-use link to `/platform/accept-invite?token=...` (7 days); only the token's hash is stored.\n\n**Errors:** 403 not an admin, 409 the email already has a staff account or an open invitation, 429.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Support\",\n  \"email\": \"{{staffInviteEmail}}\",\n  \"role\": \"support\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "pm.test('confirms the invite', () => pm.expect(pm.response.json().message).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "id": "1cb8457b-588e-5496-b622-3826f738844c",
          "name": "Accept staff invitation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "platform",
                "users",
                "invitations",
                "accept"
              ],
              "raw": "{{baseUrl}}/platform/users/invitations/accept"
            },
            "description": "**Prerequisite:** `staffInvitationToken` from the emailed link. Creates the staff account with the invited name and role. Single use; the inviter must still be an active admin.\n\n**Errors:** one generic 400.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{staffInvitationToken}}\",\n  \"password\": \"{{staffInviteePassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "pm.test('returns the new staff id', () => pm.expect(pm.response.json().platformUserId).to.be.a('string'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "875280e5-f29e-57ec-bf7e-634d3e6a490a",
      "name": "06 Sign out",
      "description": "Run these last.",
      "item": [
        {
          "id": "3a40c7ad-1e16-555f-89af-d2ac84edfd34",
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-client-type",
                "value": "{{clientType}}",
                "description": "web, desktop or mobile. Native clients get the refresh token in the body; web gets it as an httpOnly cookie."
              }
            ],
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "platform",
                "user",
                "logout"
              ],
              "raw": "{{baseUrl}}/platform/user/logout"
            },
            "description": "Public. Revokes the given session (or the cookie for web). Always 204.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{platformRefreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "id": "1afed0f9-4538-51c6-b490-7f3101dae6c9",
          "name": "Logout everywhere",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "platform",
                "user",
                "logout-all"
              ],
              "raw": "{{baseUrl}}/platform/user/logout-all"
            },
            "description": "Revokes every session of the signed-in staff member: `{ revoked }`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "pm.test('reports a count', () => pm.expect(pm.response.json().revoked).to.be.a('number'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
