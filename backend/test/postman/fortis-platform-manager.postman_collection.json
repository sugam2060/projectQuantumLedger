  "item": [
    {
      "id": "115a2d3b-3e0a-5180-b08d-34faf9fa8db5",
      "name": "01 Sign in and session",
      "description": "Fortis staff use a separate identity (`platform_users`) and token audience: staff tokens are rejected on business routes and business tokens on platform routes.\n\nEach staff member has a platform role (admin, manager or support; bootstrap = admin) that decides their platform permissions. The role travels in the token, so a change applies at the next refresh.",
      "item": [
        {
          "id": "ff64a070-2155-58c2-a13d-294935eb9438",
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-client-type",
                "value": "{{clientType}}",
                "description": "web, desktop or mobile. Native clients get the refresh token in the body; web gets it as an httpOnly cookie."
              }
            ],
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "platform",
                "user",
                "login"
              ],
              "raw": "{{baseUrl}}/platform/user/login"
            },
            "description": "**Prerequisite:** an active staff account. The first (bootstrap) account has no API: it is created directly in the database by an operator.\n\n**Errors:** 400 invalid body, 401 wrong credentials (same message for unknown emails), 429 rate limited.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{platformEmail}}\",\n  \"password\": \"{{platformPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('returns an access token', () => pm.expect(body.accessToken).to.be.a('string'));",
                  "pm.collectionVariables.set('platformAccessToken', body.accessToken);",
                  "if (body.refreshToken) pm.collectionVariables.set('platformRefreshToken', body.refreshToken);",
                  "pm.test('is a platform session', () => pm.expect(body.isPlatform).to.eql(true));",
                  "pm.collectionVariables.set('platformUserId', body.user.id);"
                ]
              }
            }
          ]
        },
        {
          "id": "064455c5-11cf-52b7-95c3-77b10b1f6a6d",
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-client-type",
                "value": "{{clientType}}",
                "description": "web, desktop or mobile. Native clients get the refresh token in the body; web gets it as an httpOnly cookie."
              },
              {
                "key": "refresh-token",
                "value": "{{platformRefreshToken}}",
                "description": "Deprecated fallback; send the body field instead.",
                "disabled": true
              }
            ],
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "platform",
                "user",
                "refresh"
              ],
              "raw": "{{baseUrl}}/platform/user/refresh"
            },
            "description": "Rotates the refresh token (body for native clients, cookie for web). Refresh single-flight: a replayed rotated token signs the staff member out everywhere. **Errors:** 401, 429.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{platformRefreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('returns an access token', () => pm.expect(body.accessToken).to.be.a('string'));",
                  "pm.collectionVariables.set('platformAccessToken', body.accessToken);",
                  "if (body.refreshToken) pm.collectionVariables.set('platformRefreshToken', body.refreshToken);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "c70e0a8a-ee01-5768-9083-40af63322bd9",
      "name": "02 Passwords",
      "description": "Same rules as business users. Reset links point to `/platform/reset-password?token=...`; copy the token into `platformResetToken`.",
      "item": [
        {
          "id": "23224324-4c33-5a52-9a79-a21057e85d36",
          "name": "Change password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-client-type",
                "value": "{{clientType}}",
                "description": "web, desktop or mobile. Native clients get the refresh token in the body; web gets it as an httpOnly cookie."
              }
            ],
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "platform",
                "user",
                "change-password"
              ],
              "raw": "{{baseUrl}}/platform/user/change-password"
            },
            "description": "Signs out every device and returns a new session. The test swaps the two password variables. **Errors:** 400, 403 wrong current password, 429.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{platformPassword}}\",\n  \"newPassword\": \"{{platformNewPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('returns an access token', () => pm.expect(body.accessToken).to.be.a('string'));",
                  "pm.collectionVariables.set('platformAccessToken', body.accessToken);",
                  "if (body.refreshToken) pm.collectionVariables.set('platformRefreshToken', body.refreshToken);",
                  "const previous = pm.collectionVariables.get('platformPassword');",
                  "pm.collectionVariables.set('platformPassword', pm.collectionVariables.get('platformNewPassword'));",
                  "pm.collectionVariables.set('platformNewPassword', previous);"
                ]
              }
            }
          ]
        },
        {
          "id": "6261ca6b-2fb6-52ad-8b63-fb5f0faea176",
          "name": "Forgot password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "platform",
                "user",
                "forgot-password"
              ],
              "raw": "{{baseUrl}}/platform/user/forgot-password"
            },
            "description": "Always 202 with the same message.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{platformEmail}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 202', () => pm.response.to.have.status(202));"
                ]
              }
            }
          ]
        },
        {
          "id": "1bf7321f-b7fc-5eeb-ad7b-b2f20cb23022",
          "name": "Reset password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "platform",
                "user",
                "reset-password"
              ],
              "raw": "{{baseUrl}}/platform/user/reset-password"
            },
            "description": "**Prerequisite:** `platformResetToken` from the emailed link. Signs out everywhere. **Errors:** one generic 400.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{platformResetToken}}\",\n  \"newPassword\": \"{{platformNewPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 204', () => pm.response.to.have.status(204));",
                  "const previous = pm.collectionVariables.get('platformPassword');",
                  "pm.collectionVariables.set('platformPassword', pm.collectionVariables.get('platformNewPassword'));",
                  "pm.collectionVariables.set('platformNewPassword', previous);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "af150c60-621f-565f-b04e-c10c29366195",
      "name": "03 Businesses and branches",
      "description": "Reading needs `platform:business:read` (every staff role). Provisioning needs `platform:business:provision` and branch creation `platform:branch:create` (admin and manager).",
      "item": [
        {
          "id": "32351ec7-fb16-5f16-ac81-0cf67e1c1bc2",
          "name": "List businesses",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-client-type",
                "value": "{{clientType}}",
                "description": "web, desktop or mobile. Native clients get the refresh token in the body; web gets it as an httpOnly cookie."
              }
            ],
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "platform"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": ">= 1"
                },
                {
                  "key": "limit",
                  "value": "20",
                  "description": "1-100"
                }
              ],
              "raw": "{{baseUrl}}/platform?page=1&limit=20"
            },
            "description": "Paginated directory of active and inactive businesses: `{ data, pagination }`. Stores the first business as `businessId`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('paginated', () => pm.expect(body.pagination.page).to.eql(1));",
                  "if (body.data.length && !pm.collectionVariables.get('businessId')) pm.collectionVariables.set('businessId', body.data[0].id);"
                ]
              }
            }
          ]
        },
        {
          "id": "e04e8875-a04f-5592-9a4e-7361f39caca8",
          "name": "Get business",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-client-type",
                "value": "{{clientType}}",
                "description": "web, desktop or mobile. Native clients get the refresh token in the body; web gets it as an httpOnly cookie."
              }
            ],
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "platform",
                "business",
                "{{businessId}}"
              ],
              "raw": "{{baseUrl}}/platform/business/{{businessId}}"
            },
            "description": "Business, its branches (active and inactive) and memberships. Stores the first branch as `branchId`. **Errors:** 400 missing or invalid x-client-type, 404."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('returns the business', () => pm.expect(body.business.id).to.eql(pm.collectionVariables.get('businessId')));",
                  "if (body.branches.length) pm.collectionVariables.set('branchId', body.branches[0].id);"
                ]
              }
            }
          ]
        },
        {
          "id": "eda32b60-04eb-5333-a81f-5ba8f3c66cdf",
          "name": "Get branch",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-client-type",
                "value": "{{clientType}}",
                "description": "web, desktop or mobile. Native clients get the refresh token in the body; web gets it as an httpOnly cookie."
              }
            ],
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "platform",
                "business",
                "{{businessId}}",
                "{{branchId}}"
              ],
              "raw": "{{baseUrl}}/platform/business/{{businessId}}/{{branchId}}"
            },
            "description": "Branch details, terminals and active employees."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "id": "00e467f0-6ded-5fc1-9a90-9414bf997205",
          "name": "Provision business",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-client-type",
                "value": "web",
                "description": "Must be web."
              },
              {
                "key": "idempotency-key",
                "value": "{{$guid}}",
                "description": "Required; the same key and payload replay the first response."
              }
            ],
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "platform",
                "businesses",
                "create"
              ],
              "query": [
                {
                  "key": "requested_business_id",
                  "value": "{{requestedBusinessId}}",
                  "description": "Id of a reviewed public business request"
                }
              ],
              "raw": "{{baseUrl}}/platform/businesses/create?requested_business_id={{requestedBusinessId}}"
            },
            "description": "**Permission:** `platform:business:provision`. Creates the business (inactive), its main branch and an inactive terminal from a reviewed public request, and emails the owner a redeem code. Idempotent and audited.\n\n**Prerequisite:** `requestedBusinessId` of a submitted request (see **04 Public business request**; the id is in `business_provisioning_requests`).\n\n**Errors:** 403, 404 unknown request, 409 duplicate or idempotency conflict, 422 invalid profile, 429.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pan\": \"{{pan}}\",\n  \"ownerEmail\": \"{{ownerEmail}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('businessId', body.businessId);",
                  "pm.test('owner activation queued', () => pm.expect(body.ownerActivationInvitationStatus).to.eql('queued'));"
                ]
              }
            }
          ]
        },
        {
          "id": "0568d79a-2bd9-5406-97d1-cd02f43bf6a1",
          "name": "Create branch",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-client-type",
                "value": "web",
                "description": "Must be web."
              },
              {
                "key": "idempotency-key",
                "value": "{{$guid}}",
                "description": "Required."
              }
            ],
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "platform",
                "businesses",
                "{{businessId}}",
                "branches"
              ],
              "raw": "{{baseUrl}}/platform/businesses/{{businessId}}/branches"
            },
            "description": "**Permission:** `platform:branch:create`. Creates a branch with its terminals (each gets an activation code) and emails the active owner. `terminals` is optional (one inactive terminal by default; up to 50).\n\n**Errors:** 403, 404 unknown business, 409 duplicate code or idempotency conflict, 422.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Branch {{$timestamp}}\",\n  \"code\": \"PM{{$randomInt}}\",\n  \"address\": \"Main Road, Kathmandu\",\n  \"contactNumber\": \"+977-1-5550101\",\n  \"terminals\": [\n    {\n      \"name\": \"Front Counter\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('branchId', body.branch.id);",
                  "pm.test('created terminals', () => pm.expect(body.terminals).to.be.an('array').that.is.not.empty);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "191766a5-aa37-5502-baf2-fd15e08fe1ff",
      "name": "04 Public business request",
      "description": "The website enquiry form. It never creates a business: staff review the request and then provision it.",
      "item": [
        {
          "id": "0386aced-9c3e-5cb0-bac5-6592972be2f8",
          "name": "Submit business request (multipart)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-client-type",
                "value": "web",
                "description": "Must be web."
              }
            ],
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "platform",
                "businesses",
                "request"
              ],
              "raw": "{{baseUrl}}/platform/businesses/request"
            },
            "description": "Public, web only, 5 requests per hour per client. All three documents are required (stored in Cloudinary). Answers 201 with a generic acknowledgement.\n\n**Prerequisite:** replace the three `/path/to/...` placeholders with local files.\n\n**Errors:** 400 missing fields or files, 413 file too large, 429.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "legalName",
                  "value": "Example Retail Pvt. Ltd.",
                  "type": "text"
                },
                {
                  "key": "displayName",
                  "value": "Example Retail",
                  "type": "text"
                },
                {
                  "key": "country",
                  "value": "NP",
                  "type": "text",
                  "description": "Two-letter country code"
                },
                {
                  "key": "city",
                  "value": "Kathmandu",
                  "type": "text"
                },
                {
                  "key": "postalCode",
                  "value": "44600",
                  "type": "text"
                },
                {
                  "key": "addressLine1",
                  "value": "Main Road",
                  "type": "text"
                },
                {
                  "key": "addressLine2",
                  "value": "",
