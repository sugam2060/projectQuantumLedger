              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/business/endpoint-access"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
