        {
          "name": "GET /platform/business/{business_id}",
          "request": {
            "method": "GET",
            "description": "Platform-manager-only business detail lookup. Returns the business, every branch (active and inactive), and business memberships with their user, role, and branch details.",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{platformAccessToken}}",
                "type": "text"
              },
              {
                "key": "X-Client-Type",
                "value": "{{platformClientType}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/platform/business/{{businessId}}"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.expect(pm.response.code).to.eql(200));",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('business');",
                  "  pm.expect(body).to.have.property('branches');",
                  "  pm.expect(body).to.have.property('memberships');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /platform/businesses/create",
          "request": {
            "method": "POST",
            "description": "Platform-only, web-client provisioning. Requires a pending request ID, PAN, and platform access token. Creates the initial branch and terminal and queues the owner redemption email.",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{platformAccessToken}}",
                "type": "text"
              },
              {
                "key": "X-Client-Type",
                "value": "web",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{provisioningIdempotencyKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/platform/businesses/create?requested_business_id={{requestedBusinessId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pan\": \"ABCDE1234F\",\n  \"ownerEmail\": \"{{ownerEmail}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.expect(pm.response.code, `Provisioning failed (${pm.response.code}): ${pm.response.text()}`).to.eql(201));",
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.test(\"Response includes business ID and queued invitation\", () => {",
                  "    pm.expect(body.businessId, `Unexpected response: ${pm.response.text()}`).to.be.a(\"string\");",
                  "    pm.expect(body.ownerActivationInvitationStatus).to.eql(\"queued\");",
                  "  });",
                  "  pm.collectionVariables.set(\"provisionedBusinessId\", body.businessId);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
