        {
          "name": "POST /authentication/register-owner",
          "request": {
            "method": "POST",
            "description": "Web-only owner activation. First provision a business, then paste the code received by email into ownerRedeemCode. The response includes the initial terminal ID for subsequent login.",
            "header": [
              {
                "key": "X-Client-Type",
                "value": "web",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/authentication/register-owner",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{ownerEmail}}\",\n  \"name\": \"Example Owner\",\n  \"password\": \"{{ownerPassword}}\",\n  \"redeemCode\": \"{{ownerRedeemCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.expect(body.isOwner).to.eql(true);",
                  "pm.expect(body.roleId).to.eql(null);",
                  "pm.expect(body.branchId).to.eql(null);",
                  "pm.collectionVariables.set(\"userId\", body.userId);",
                  "if (body.initialTerminalId) pm.collectionVariables.set(\"terminalId\", body.initialTerminalId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Normal user logout test",
          "description": "Run these three requests in order. Requires a normal active user assigned to terminalId, and userEmail/userPassword set. The flow logs in, revokes the refresh token, then verifies that refresh is rejected.",
          "item": [
            {
              "name": "1. Login normal user for logout test",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json",
                    "type": "text"
                  },
                  {
                    "key": "x-client-type",
                    "value": "{{userClientType}}",
                    "type": "text"
                  },
                  {
                    "key": "x-terminal-id",
                    "value": "{{terminalId}}",
                    "type": "text"
                  }
                ],
                "url": "{{baseUrl}}/authentication/login",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\",\n  \"remember\": true\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "response": [],
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Login succeeds for the normal user', () => pm.response.to.have.status(200));",
                      "const body = pm.response.json();",
                      "pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
                      "pm.expect(body.refreshToken).to.be.a('string').and.not.empty;",
                      "pm.collectionVariables.set('logoutTestAccessToken', body.accessToken);",
                      "pm.collectionVariables.set('logoutTestRefreshToken', body.refreshToken);"
                    ]
                  }
                }
              ]
            },
            {
              "name": "2. Logout normal user",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json",
                    "type": "text"
                  },
                  {
                    "key": "x-client-type",
                    "value": "{{userClientType}}",
                    "type": "text"
                  }
                ],
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{logoutTestAccessToken}}",
                      "type": "string"
                    }
                  ]
                },
                "url": "{{baseUrl}}/authentication/logout",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"refreshToken\": \"{{logoutTestRefreshToken}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "response": [],
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Logout succeeds', () => pm.response.to.have.status(200));",
                      "pm.expect(pm.response.json()).to.deep.equal({ revoked: true });"
                    ]
                  }
                }
              ]
            },
            {
              "name": "3. Verify revoked refresh token is rejected",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json",
                    "type": "text"
                  },
                  {
                    "key": "x-client-type",
                    "value": "{{userClientType}}",
                    "type": "text"
                  },
                  {
                    "key": "x-terminal-id",
                    "value": "{{terminalId}}",
                    "type": "text"
                  }
                ],
                "url": "{{baseUrl}}/authentication/refresh",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"refreshToken\": \"{{logoutTestRefreshToken}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "response": [],
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Revoked refresh token is rejected', () => pm.response.to.have.status(401));",
                      "pm.collectionVariables.unset('logoutTestAccessToken');",
                      "pm.collectionVariables.unset('logoutTestRefreshToken');"
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    },
